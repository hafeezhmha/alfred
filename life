#!/usr/bin/env bash
# Life OS launcher. Plain bash, works on macOS (bash 3.2) and Linux.
set -eu

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

REVIEW_STAMP=".life/last-weekly-review"

# All awk below strips a trailing \r so files saved with Windows line endings work.

section() { # print the body of a "## <name>" section of a markdown file
  H="## $2" awk '{sub(/\r$/, "")} $0 == ENVIRON["H"] {f=1; next} /^## /{f=0} f' "$1" | sed '/^[[:space:]]*$/d'
}

# Days since a fixed epoch (civil calendar), for awk. No `date -d`, so it runs on macOS.
DAYFN='function day(s,   y, m, d) { y = substr(s, 1, 4) + 0; m = substr(s, 6, 2) + 0; d = substr(s, 9, 2) + 0
  if (m < 3) { y--; m += 12 }
  return 365 * y + int(y / 4) - int(y / 100) + int(y / 400) + int((153 * (m - 3) + 2) / 5) + d }'
TODAY="$(date +%Y-%m-%d)"

die() { echo "error: $*" >&2; exit 2; }

# ---------- queue model ----------
# Items are "- " lines under the known "## " sections of queue.md. Ids are the
# section letter plus position (n1 = first Now item), recomputed on every call
# and never stored, so hand edits always work.
#   n Now · x Next · w Waiting on · i Inbox · s Someday · d Done this week
QKEYS="n x w i s d"
qname() { case "$1" in n) echo "Now";; x) echo "Next";; w) echo "Waiting on";; i) echo "Inbox";; s) echo "Someday";; d) echo "Done this week";; esac; }
qkey() { case "$1" in now|n) echo n;; next|x) echo x;; waiting|wait|w) echo w;; inbox|i) echo i;; someday|s) echo s;; done|d) echo d;; *) return 1;; esac; }
QKEYFN='function key(h) { if (h == "## Now") return "n"; if (h == "## Next") return "x"; if (h == "## Waiting on") return "w"
  if (h == "## Inbox") return "i"; if (h == "## Someday") return "s"; if (h == "## Done this week") return "d"; return "" }'

q_items() { # key<TAB>index<TAB>line<TAB>text, one row per item
  awk "$QKEYFN"'
    { sub(/\r$/, "") }
    /^```/ { fence = !fence; next }
    fence { next }
    /^##? / { k = key($0); next }
    k != "" && /^- / { t = $0; sub(/^- (\[[ xX]\] )?/, "", t); c[k]++; printf "%s\t%d\t%d\t%s\n", k, c[k], NR, t }
  ' queue.md
}

q_count() { printf '%s\n' "$QITEMS" | awk -F'\t' -v k="$1" '$1 == k' | grep -c . || true; }

q_list() { # print one section: header with count, then "id text" rows
  k="$1"; n="$(q_count "$k")"; label="$(qname "$k" | tr 'A-Z ' 'a-z_')"
  [ "$k" = n ] && head="now[$n/3]" || head="${label}[$n]"
  if [ "$n" = 0 ]; then echo "$head: none"; return; fi
  if [ "$k" = w ]; then
    echo "$head{id,days,item}:"
    printf '%s\n' "$QITEMS" | T="$TODAY" awk -F'\t' -v k=w "$DAYFN"'
      $1 == k { d = "-"; if (match($4, /20[0-9][0-9]-[01][0-9]-[0-3][0-9]/)) d = day(ENVIRON["T"]) - day(substr($4, RSTART, 10))
                printf "  w%d %s %s\n", $2, d, $4 }'
  else
    echo "$head:"
    printf '%s\n' "$QITEMS" | awk -F'\t' -v k="$k" '$1 == k { printf "  %s%d %s\n", k, $2, $4 }'
  fi
}

q_load() { [ -f queue.md ] || die "queue.md is missing. run: ./life check"; QITEMS="$(q_items)"; }

q_ids_summary() { # "now: n1-n2, next: x1-x3" for error messages
  out=""; for k in $QKEYS; do c="$(q_count "$k")"; [ "$c" = 0 ] || { r="${k}1"; [ "$c" = 1 ] || r="$r-$k$c"; out="$out${out:+, }$(qname "$k" | tr 'A-Z' 'a-z'): $r"; }; done
  echo "${out:-queue is empty}"
}

q_resolve() { # one id or unique substring -> "key<TAB>index<TAB>line<TAB>text"
  case "$1" in
    [nxwisd][0-9]|[nxwisd][0-9][0-9])
      m="$(printf '%s\n' "$QITEMS" | awk -F'\t' -v k="${1%%[0-9]*}" -v n="${1#?}" '$1 == k && $2 == n')" ;;
    *) m="$(printf '%s\n' "$QITEMS" | A="$1" awk -F'\t' 'index(tolower($4), tolower(ENVIRON["A"]))')" ;;
  esac
  c="$(printf '%s' "$m" | grep -c . || true)"
  [ "$c" = 1 ] && { printf '%s\n' "$m"; return; }
  [ "$c" = 0 ] && die "no item '$1' ($(q_ids_summary)). run: ./life queue"
  die "'$1' matches $c items ($(printf '%s\n' "$m" | awk -F'\t' '{ sep = ", "; if (NR == 1) sep = ""; printf "%s%s%d", sep, $1, $2 }')). use an id"
}

q_apply() { # args: line:target:pos ...  (pos top|bottom). Removes those lines, reinserts them under target sections.
  tmp="$(mktemp)"
  L="$*" D="$TODAY" W="${WAIT_WHO:-}" awk "$QKEYFN"'
    function fmt(t, k,   s) { s = t; sub(/\r$/, "", s); sub(/^- (\[[ xX]\] )?/, "", s)
      if (k == "d") return "- [x] " s
      if (k == "w") { if (ENVIRON["W"] != "") s = ENVIRON["W"] ": " s; if (s !~ /since 20[0-9][0-9]-/) s = s ", since " ENVIRON["D"]; return "- " s }
      if (k == "s") return "- " s
      return "- [ ] " s }
    BEGIN { n = split(ENVIRON["L"], a, " ")
            for (i = 1; i <= n; i++) { split(a[i], p, ":"); ln[i] = p[1]; tg[i] = p[2]; ps[i] = p[3]; mv[p[1]] = 1 } }
    FNR == NR { raw = $0; sub(/\r$/, "", raw); cl[FNR] = raw; FNRMAX = FNR
                if (raw ~ /^```/) fence = !fence
                if (!fence && raw ~ /^##? /) { cur = key(raw); if (cur != "") { hdr[cur] = FNR; lastnb[cur] = FNR }; next }
                if (cur != "" && !(FNR in mv)) {
                  if (raw ~ /^- /) { if (!(cur in first)) first[cur] = FNR; lastitem[cur] = FNR }
                  if (raw !~ /^[ \t]*$/) lastnb[cur] = FNR }
                next }
    FNR == 1 { for (i = 1; i <= n; i++) if (!(tg[i] in hdr)) { bad = 1; exit 3 }
               for (k in hdr) { anchor[k] = (k in lastitem) ? lastitem[k] : lastnb[k]
                 # an empty section: land after the blank line that follows its header or prose
                 if (!(k in lastitem)) { nx = anchor[k] + 1; if (!(nx in mv) && cl[nx] ~ /^[ \t]*$/ && nx <= FNRMAX) anchor[k] = nx; else lead[k] = 1 } } }
    { for (i = 1; i <= n; i++) if (ps[i] == "top" && (tg[i] in first) && first[tg[i]] == FNR) print fmt(cl[ln[i]], tg[i]) }
    !(FNR in mv) { print }
    { for (k in anchor) if (anchor[k] == FNR) { started = 0
        for (i = 1; i <= n; i++) if (tg[i] == k && !(ps[i] == "top" && (k in first))) {
          if (!started && (k in lead)) print ""
          started = 1; print fmt(cl[ln[i]], k) }
        if (started && cl[FNR + 1] ~ /^##? /) print "" } }
  ' queue.md queue.md > "$tmp.raw" || { rm -f "$tmp" "$tmp.raw"; die "a target section is missing from queue.md. run: ./life check"; }
  cat -s "$tmp.raw" > "$tmp"; rm -f "$tmp.raw"   # removed items can leave two blank lines in a row
  mv "$tmp" queue.md
}

now_room() { # $1 = items arriving in Now, $2 = items leaving Now
  have="$(q_count n)"; total=$(( have - $2 + $1 ))
  [ "$total" -le 3 ] || die "Now is full ($have/3; this would make $total). make room first: ./life move n$have next"
}

cmd_queue() {
  q_load
  if [ -n "${1:-}" ] && [ "$1" != all ]; then k="$(qkey "$1")" || die "unknown section '$1' (now, next, waiting, inbox, someday, done, all)"; q_list "$k"; return; fi
  for k in $QKEYS; do q_list "$k"; done
  echo "next:"
  echo "  ./life move <id...> <section>   e.g. ./life move i1 next"
  echo "  ./life done <id...>             only after they confirm"
}

cmd_move() { # move <id...> <section>
  [ $# -ge 2 ] || die 'usage: ./life move <id...> <section>   e.g. ./life move i1 i2 next'
  dest="${!#}"; tk="$(qkey "$dest")" || die "unknown section '$dest' (now, next, waiting, inbox, someday, done)"
  q_load; specs=""; seen=" "; msgs=""; in_now=0; out_now=0; i=1
  while [ $i -lt $# ]; do
    eval "arg=\${$i}"; r="$(q_resolve "$arg")"
    k="$(printf '%s' "$r" | cut -f1)"; idx="$(printf '%s' "$r" | cut -f2)"; ln="$(printf '%s' "$r" | cut -f3)"; txt="$(printf '%s' "$r" | cut -f4)"
    i=$((i + 1))
    case "$seen" in *" $ln "*) continue;; esac; seen="$seen$ln "
    if [ "$k" = "$tk" ]; then msgs="$msgs  ok: $k$idx already in $(qname "$tk"): $txt
"; continue; fi
    [ "$tk" = n ] && in_now=$((in_now + 1)); [ "$k" = n ] && out_now=$((out_now + 1))
    specs="$specs $ln:$tk:bottom"; msgs="$msgs  ok: $k$idx -> $(qname "$tk"): $txt
"
  done
  [ "$tk" = n ] && now_room "$in_now" "$out_now"
  [ -z "$specs" ] || q_apply $specs
  printf '%s' "$msgs"; q_load; q_list "$tk"
}

cmd_done() { # moves items to Done this week and adds each as a win in today's log entry
  [ $# -ge 1 ] || die "usage: ./life done <id...>   (their \"it is done\" is the yes)"
  q_load; local logwins=()
  for a in "$@"; do r="$(q_resolve "$a")"; [ "$(printf '%s' "$r" | cut -f1)" = d ] || logwins+=(--done "$(printf '%s' "$r" | cut -f4)"); done
  cmd_move "$@" "done"
  if [ ${#logwins[@]} -gt 0 ]; then cmd_log "${logwins[@]}" >/dev/null; echo "  logged as a win in today's current.md entry"; fi
}

cmd_wait() { # wait <id> ["who"]
  [ $# -ge 1 ] || die 'usage: ./life wait <id> ["who"]   e.g. ./life wait x2 "Ana"'
  WAIT_WHO="$(printf '%s' "${2:-}" | tr '\r\n\t:' '    ')" cmd_move "$1" waiting
}

cmd_plan() { # plan <id...>: Now becomes exactly these, in this order; the rest of Now goes to the top of Next
  [ $# -ge 1 ] && [ $# -le 3 ] || die 'usage: ./life plan <id...>   1 to 3 items, e.g. ./life plan n1 x2'
  q_load; specs=""; chosen=" "
  for arg in "$@"; do
    r="$(q_resolve "$arg")"; ln="$(printf '%s' "$r" | cut -f3)"
    case "$chosen" in *" $ln "*) continue;; esac; chosen="$chosen$ln "
  done
  for ln in $(printf '%s\n' "$QITEMS" | awk -F'\t' '$1 == "n" { print $3 }'); do
    case "$chosen" in *" $ln "*) ;; *) specs="$specs $ln:x:top";; esac
  done
  for ln in $chosen; do specs="$specs $ln:n:bottom"; done
  q_apply $specs
  mkdir -p .life; echo "$TODAY" > .life/last-plan; pending_clear plan
  echo "ok: Now planned for $TODAY"; q_load; q_list n
  echo "next:"
  echo "  name ONE first step for n1, under two minutes"
}

cmd_add() { # add "text" [--now|--next]
  where=i
  case "${1:-}" in --now) where=n; shift;; --next) where=x; shift;; esac
  case "${!#:-}" in --now) where=n; set -- "${@:1:$(($#-1))}";; --next) where=x; set -- "${@:1:$(($#-1))}";; esac
  [ $# -gt 0 ] || die 'usage: ./life add "thing to remember" [--now|--next]'
  text="$(printf '%s' "$*" | tr '\r\n\t' '   ')"
  if [ "$where" = n ]; then q_load; now_room 1 0; fi
  line="- [ ] $text"; [ "$where" = i ] && line="$line ($TODAY)"
  tmp="$(mktemp)"
  # Passed via ENVIRON, not -v, so backslashes in the text stay literal.
  L="$line" H="## $(qname "$where")" awk '
    BEGIN { l = ENVIRON["L"] }
    { h = $0; sub(/\r$/, "", h) }
    h ~ /^## / { if (in_s && !done) { print l; print ""; done=1; blanks=0 } in_s = (h == ENVIRON["H"]) }
    { if (in_s && h ~ /^[[:space:]]*$/) { blanks++; next }
      while (blanks > 0) { print ""; blanks-- }
      print }
    END { if (in_s && !done) { print l; done=1 } if (!done) exit 3 }
  ' queue.md > "$tmp" || { rm -f "$tmp"; die "no '## $(qname "$where")' section in queue.md; add one first."; }
  mv "$tmp" queue.md
  echo "Captured to $(qname "$where"): $text"
}

# ---------- log: today's current.md entry ----------
cmd_log() { # log --stopped "..." [--topic ..] [--working ..] [--done ..]... [--energy ..] [--new]
  topic=""; stopped=""; energy=""; working=""; said=""; said_auto=""; energy_auto=""; dones=""; new=0; has=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --topic|--stopped|--energy|--working|--done|--said)
        [ $# -ge 2 ] || die "$1 needs a value, e.g. $1 \"...\""
        v="$(printf '%s' "$2" | tr '\r\n\t' '   ')"; has=1
        case "$1" in --topic) topic="$v";; --stopped) stopped="$v";; --energy) energy="$v";; --working) working="$v";; --said) said="$v";;
          --done) dones="$dones$v"$'\036';; esac
        shift 2 ;;
      --new) new=1; shift ;;
      *) die "unknown flag '$1'. flags: --stopped --said --topic --working --done --energy --new" ;;
    esac
  done
  [ "$has" = 1 ] || die 'usage: ./life log --stopped "exact point" [--said "their words"] [--topic ..] [--done ..]... [--energy ..] [--new]'
  if [ -z "$said" ] && [ -n "$stopped" ]; then said="$(said_from_message)"; [ -z "$said" ] || said_auto=1; fi
  # energy without its cause (a bare "low") or missing at wrap-up: use their own sentence about energy
  case "$energy" in *" "*) ;; *)
    if [ -n "$energy" ] || pending_list | grep -qx log; then
      es="$(energy_from_message)"
      if [ -n "$es" ] && [ "$es" != "$said" ]; then energy="${energy:+$energy, }in their words: \"$es\""; energy_auto=1; fi
    fi ;; esac
  top="$(awk '{sub(/\r$/, "")} /^```/{f=!f} !f && /^## 20[0-9][0-9]-[01][0-9]-[0-3][0-9]/{print substr($0, 4, 10); exit}' current.md)"
  mode=new; [ "$top" = "$TODAY" ] && [ "$new" = 0 ] && mode=merge
  tmp="$(mktemp)"
  M="$mode" D="$TODAY" TP="$topic" ST="$stopped" SD="$said" EN="$energy" WK="$working" DN="$dones" awk '
    function out(   i, s) {
      hd = "day"; if (tp != "") hd = tp; if (ENVIRON["TP"] != "") hd = ENVIRON["TP"]
      print "## " ENVIRON["D"] " — " hd; print ""
      if (ENVIRON["WK"] != "") wk = "Working on: " ENVIRON["WK"]
      if (wk != "") { print wk; print "" }
      nd = split(ENVIRON["DN"], dn, "\036")
      for (i = 1; i <= dc; i++) { k = tolower(done[i]); gsub(/[^a-z0-9]/, "", k); have[k] = 1 }
      for (i = 1; i <= nd; i++) if (dn[i] != "") { k = tolower(dn[i]); gsub(/[^a-z0-9]/, "", k); if (!(k in have)) { done[++dc] = "- " dn[i]; have[k] = 1 } }
      if (dc) { print "Done:"; for (i = 1; i <= dc; i++) print done[i]; print "" }
      if (ENVIRON["ST"] != "") st = "Stopped at: " ENVIRON["ST"]
      if (ENVIRON["SD"] != "") sd = "Their words: \"" ENVIRON["SD"] "\""
      if (st != "") { print st; if (sd == "") print "" }
      if (sd != "") { print sd; print "" }
      if (ENVIRON["EN"] != "") en = "Energy: " ENVIRON["EN"]
      if (en != "") { print en; print "" }
      for (i = 1; i <= xc; i++) { print extra[i]; s = 1 }
      if (s) print ""
      print "Next: see queue.md."; print "" }
    { sub(/\r$/, "") }
    /^```/ { fence = !fence }
    !fence && /^## / {
      if (state == "in") { out(); state = "after" }
      if (state == "" && $0 ~ /^## 20[0-9][0-9]-[01][0-9]-[0-3][0-9]/) {
        if (ENVIRON["M"] == "new") { out(); state = "after" }
        else { state = "in"; tp = $0; sub(/^## [^ ]+ *(— *)?/, "", tp); next } } }
    state == "in" {
      if ($0 ~ /^Working on:/) { f = "wk"; wk = $0; next }
      if ($0 ~ /^Done:/) { f = "dn"; next }
      if ($0 ~ /^Stopped at:/) { f = "st"; st = $0; next }
      if ($0 ~ /^Their words:/) { f = ""; sd = $0; next }
      if ($0 ~ /^Energy:/) { f = "en"; en = $0; next }
      if ($0 ~ /^Next:/) { f = ""; next }
      if ($0 ~ /^[ \t]*$/) { f = ""; next }
      if (f == "dn" && $0 ~ /^- /) { done[++dc] = $0; next }
      if (f == "wk") { wk = wk "\n" $0; next }
      if (f == "st") { st = st "\n" $0; next }
      if (f == "en") { en = en "\n" $0; next }
      extra[++xc] = $0; next }
    { print }
    END { if (state == "in") out(); else if (state == "") { print ""; out() } }
  ' current.md | cat -s > "$tmp"
  mv "$tmp" current.md
  lines="$(awk '{sub(/\r$/, "")} /^```/{f=!f} !f && /^## 20[0-9][0-9]-/{n++} n==1' current.md | grep -c . || true)"
  # wrap-up is settled only once today's entry carries their own words
  if awk '{sub(/\r$/, "")} /^```/{f=!f} !f && /^## 20[0-9][0-9]-/{n++} n==1' current.md | grep -q '^Their words:'; then pending_clear log; fi
  echo "ok: log $([ "$mode" = merge ] && echo "updated" || echo "added") for $TODAY"
  awk '{sub(/\r$/, "")} /^```/{f=!f} !f && /^## 20[0-9][0-9]-/{n++} n==1' current.md | sed '/^$/d; s/^/  /'
  [ "$lines" -le 15 ] || echo "note: today's entry is $lines lines; detail belongs in areas/<area>/README.md"
  [ -z "$said_auto" ] || echo "their words, from their last message: \"$said\""
  [ -z "$energy_auto" ] || echo "energy, from their last message: $energy"
  if pending_list | grep -qx log; then
    echo "pending: log still needs their exact words about where they stopped: ./life log --said \"<their words, unchanged>\" (or ./life pending clear log if they didn't say)"
  elif [ -n "$stopped" ] && [ -z "$said" ]; then echo "note: no --said; add their exact words about where they stopped: ./life log --said \"...\""; fi
  [ -n "$energy_auto" ] || case "$energy" in ""|*" "*) ;; *) echo "note: energy \"$energy\" has no cause; add what affected it: ./life log --energy \"$energy, <what affected it>\"";; esac
  echo "next:"
  echo "  check the entry uses their words (\"got as far as\" is not \"done\"), one --done per win, energy with its cause"
  echo "  report in under six lines, ending with tomorrow's first step; never \"anything else?\""
  grep -q '^Stopped at:' <<EOF2 || echo "note: no \"Stopped at\" yet; add it at wrap-up: ./life log --stopped \"...\""
$(awk '{sub(/\r$/, "")} /^```/{f=!f} !f && /^## 20[0-9][0-9]-/{n++} n==1' current.md)
EOF2
}

# ---------- private therapy notes ----------
cmd_therapy_note() {
  if [ "${1:-}" = --count ]; then echo "therapy_notes_this_week: $(therapy_count) (say only the number; never read them)"; return; fi
  [ $# -ge 1 ] || die 'usage: ./life therapy-note "their words"   (only on their yes)'
  if git rev-parse --git-dir >/dev/null 2>&1 && ! git check-ignore -q private/therapy-notes.md; then
    die "private/ is not git-ignored here, so the note could be committed. add 'private/' to .gitignore first"
  fi
  mkdir -p private
  printf -- '- %s: %s\n' "$TODAY" "$(printf '%s' "$*" | tr '\r\n\t' '   ')" >> private/therapy-notes.md
  echo "ok: noted for their therapist (private/therapy-notes.md, not in git). Don't read other notes back."
}

therapy_count() { # notes dated in the last 7 days; count only, never content
  [ -f private/therapy-notes.md ] || { echo 0; return; }
  T="$TODAY" awk "$DAYFN"' BEGIN { t = day(ENVIRON["T"]) }
    /^- 20[0-9][0-9]-[01][0-9]-[0-3][0-9]:/ { if (t - day(substr($0, 3, 10)) < 7) c++ } END { print c + 0 }' private/therapy-notes.md
}

# ---------- getting to know them (setup's one-question-a-day) ----------
learn_dest() { # where an answer goes, by topic name
  case "$1" in
    Support|Parts) echo 'private/support.md ONLY (never a tracked file)' ;;
    Brain|Home|People) echo 'ask "OK to keep this in the repo, or private?" then context.md or private/support.md' ;;
    Energy) echo 'context.md "How my brain works"' ;;
    "Day shape"|"Fixed commitments") echo 'context.md "Fixed commitments" and "Constraints"' ;;
    Areas) echo 'context.md "Areas" + areas/<slug>/README.md from areas/_template.md' ;;
    Capture) echo 'context.md "Tools"' ;;
    "Past systems") echo 'context.md "How my brain works" (the pattern, not the story)' ;;
    Language|"Never suggest") echo 'AGENTS.md "About the person"' ;;
    Nudge) echo 'on a yes: ./life nudge on HH:MM [private]' ;;
    *) echo 'wherever it fits; tracked files hold nothing sensitive' ;;
  esac
}

learn_due() { # prints "tN<TAB>topic line" of the next open topic if one is due today
  [ -f .life/to-learn.md ] || return 0
  asked="$(sed -n 's/^Last asked: *//p' .life/to-learn.md | tr -d '\r')"
  [ "$asked" = "$TODAY" ] && return 0
  awk '{sub(/\r$/, "")} /^- \[[ xX]\] /{n++} /^- \[ \] /{sub(/^- \[ \] /, ""); printf "t%d\t%s\n", n, $0; exit}' .life/to-learn.md
}

cmd_learn() {
  [ -f .life/to-learn.md ] || { echo "learn: none (setup has nothing left to ask)"; return; }
  asked="$(sed -n 's/^Last asked: *//p' .life/to-learn.md | tr -d '\r')"
  if [ "$asked" = "$TODAY" ]; then echo "learn: already asked today; next one tomorrow"; return; fi
  r="$(learn_due)"; [ -n "$r" ] || { echo "learn: done (0 topics left)"; return; }
  id="$(printf '%s' "$r" | cut -f1)"; line="$(printf '%s' "$r" | cut -f2)"; name="${line%%:*}"
  echo "learn: $id $line"
  echo "  ask: at the END of a session only, one question with a suggested answer, framed \"Quick one, skip anytime:\""
  echo "  never: in a session that used /stuck, on a rough day, when they're in a hurry"
  echo "  write: $(learn_dest "$name")"
  echo "  notes:"
  N="$name" awk '{sub(/\r$/, "")} /^## /{f = (substr($0, 4) == ENVIRON["N"]); next} f && NF {print "    " $0}' .claude/skills/life-architect/topics.md
  echo "next:"
  echo "  ./life learned $id          after writing the answer"
  echo "  ./life learned $id --skip   if they skip"
}

cmd_learned() { # learned tN [--skip]
  [ -f .life/to-learn.md ] || die "no .life/to-learn.md (nothing left to learn)"
  case "${1:-}" in t[0-9]|t[0-9][0-9]) ;; *) die 'usage: ./life learned <tN> [--skip]   e.g. ./life learned t1';; esac
  skip=0; [ "${2:-}" = --skip ] && skip=1
  tmp="$(mktemp)"
  N="${1#t}" S="$skip" D="$TODAY" awk '
    { sub(/\r$/, "") }
    /^Last asked:/ { $0 = "Last asked: " ENVIRON["D"] }
    /^- \[[ xX]\] / { n++
      if (n == ENVIRON["N"] + 0) { hit = 1
        if (ENVIRON["S"] == 1 && $0 ~ /\(skipped\)$/) { sub(/^- \[ \] /, "- [x] "); sub(/\(skipped\)$/, "(skipped twice, dropped)"); res = "dropped after two skips" }
        else if (ENVIRON["S"] == 1) { if ($0 !~ /\(skipped\)$/) $0 = $0 " (skipped)"; res = "skipped; it comes back another day" }
        else { sub(/^- \[ \] /, "- [x] "); res = "learned" } } }
    { print }
    END { if (!hit) exit 3; print res > "/dev/stderr" }
  ' .life/to-learn.md > "$tmp" 2>"$tmp.msg" || { rm -f "$tmp" "$tmp.msg"; die "no topic $1. run: ./life learn"; }
  mv "$tmp" .life/to-learn.md
  echo "ok: $1 $(cat "$tmp.msg"); next question tomorrow at the earliest"; rm -f "$tmp.msg"
}

# ---------- pending writes (the ritual's owed write) and the stop gate ----------
# A ritual owes one write: plan-day -> plan, wrap-up -> log, review -> reviewed.
# Only today's lines count, so nothing stale ever blocks.
PENDING=".life/pending"
pending_add() { mkdir -p .life; pending_list | grep -qx "$1" || echo "$TODAY $1" >> "$PENDING"; }
pending_clear() { [ -f "$PENDING" ] || return 0; tmp="$(mktemp)"; grep -v " $1\$" "$PENDING" > "$tmp" || true; mv "$tmp" "$PENDING"; }
pending_list() { [ -f "$PENDING" ] && awk -v t="$TODAY" '$1 == t { print $2 }' "$PENDING" | sort -u || true; }
pending_hint() { # one line at the end of any command, only if something is owed
  p="$(pending_list | tr '\n' ' ' | sed 's/ $//')"; [ -n "$p" ] || return 0
  echo "pending: $p (a write this ritual still owes: $(for w in $p; do case "$w" in plan) printf './life plan <ids> ';; log) printf './life log --stopped .. ';; reviewed) printf './life reviewed --focus .. ';; esac; done)after their yes; if they chose not to: ./life pending clear $p)"
}

cmd_pending() {
  case "${1:-}" in
    "") p="$(pending_list)"; if [ -z "$p" ]; then echo "pending: none"; else echo "pending: $(echo $p)"; fi ;;
    clear) shift; if [ -z "${1:-}" ] || [ "$1" = all ]; then rm -f "$PENDING"; else for w in "$@"; do pending_clear "$w"; done; fi; echo "ok: pending cleared" ;;
    *) die "usage: ./life pending [clear [plan|log|reviewed|all]]" ;;
  esac
}

cmd_gate() { # Stop hook for Claude Code and Codex (exit 2 = keep going). Run by hand in OpenCode.
  # hooks send their JSON at once; the timeout keeps a manual run from waiting on an open stdin
  input=""; if [ ! -t 0 ]; then while IFS= read -r -t 2 line; do input="$input$line"; done; input="$input${line:-}"; fi
  printf '%s' "$input" | grep -Eq '"stop_hook_active" *: *true' && return 0   # blocked once already: let it stop
  [ -f .life/SETUP_NEEDED ] && return 0
  # the agent's last message (both agents send it); trailing markdown and spaces trimmed
  last="$(printf '%s' "$input" | sed -nE 's/.*"last_assistant_message" *: *"(([^"\\]|\\.)*)".*/\1/p' | sed -E 's/(\\n|[[:space:]*_)"`])+$//')"
  if printf '%s' "$last" | grep -Eqi 'anything else\?*$'; then
    echo "Life OS: end with one concrete next step, not \"anything else?\". Rewrite your last line." >&2
    exit 2
  fi
  case "$last" in *\?) return 0 ;; esac   # a question: waiting on the person, nothing is late yet
  p="$(pending_list | tr '\n' ' ' | sed 's/ $//')"
  if [ -n "$p" ]; then
    extra=""; case " $p " in *" log "*) extra=" For log: today's entry needs their exact words, ./life log --said \"<their words>\"." ;; esac
    echo "Life OS: this ritual still owes a write ($p).$extra If the person said yes, do it now with ./life (see ./life help). If they chose not to or want to stop, run: ./life pending clear $p. Then finish your reply." >&2
    exit 2
  fi
  [ -t 1 ] && echo "gate: clear"
  return 0
}

# ---------- safety net: crisis language in what the person just sent ----------
# A UserPromptSubmit hook (Claude Code and Codex) runs this on every message;
# its stdout reaches the model before it replies. It adds to the written crisis
# rule in AGENTS.md, never replaces it. OpenCode has no such hook.
CRISIS_RE="what'?s the point|what is the point|no point (in|of) (living|anything|life|going on|trying)|kill (myself|me)|suicid|end (it all|my life|things|everything)|want(ed)? to die|wanna die|better off (dead|without me)|(don'?t|do not) want to (be here|live|exist|wake up)|not wake up|disappear|burden|hopeless|hate myself|fail(ing)? at everything|hurt(ing)? myself|self[- ]?harm|cut(ting)? myself|can'?t go on|give up on (life|everything)|mar ja(na|un|unga|ungi)|marna chah|jeena nahi|jeene ka ma(n|nn) nahi|khud ko khatam"

LAST_MSG=".life/last-message"   # git-ignored, local, replaced on every message
remember_message() { # keep the person's latest message verbatim, so log can quote them
  printf '%s' "$1" | grep -q '"prompt"' || return 0
  # shellcheck disable=SC1112  # a curly apostrophe restored on purpose, as they typed it
  m="$(printf '%s' "$1" | sed -nE 's/.*"prompt" *: *"(([^"\\]|\\.)*)".*/\1/p' | sed -e 's/\\n/ /g' -e 's/\\"/"/g' -e 's/\\u2019/’/g')"
  [ -n "$m" ] || return 0
  mkdir -p .life; printf '%s\t%s\n' "$TODAY" "$m" > "$LAST_MSG"
}

sentence_from_message() { # $1 = regex; the first sentence of today's latest message that matches, unchanged
  [ -f "$LAST_MSG" ] || return 0
  # one sentence per line (awk, not sed: macOS sed can't put a newline in a replacement)
  awk -F'\t' -v t="$TODAY" '$1 == t { m = $0; sub(/^[^\t]*\t/, "", m); n = split(m, p, /[.!?]+ +/); for (i = 1; i <= n; i++) print p[i] }' "$LAST_MSG" | \
    grep -Ei "$1" | head -1 | sed -E 's/[.!?]+$//; s/^ +//' || true
}
said_from_message() { sentence_from_message "stopped|got (as far as|to|through|up to)|left (it )?off|halfway|up to (page|step|the)|paused (at|on)|as far as"; }
energy_from_message() { sentence_from_message "energy|tired|exhausted|drained|wiped|sleepy|burn(ed|t)? ?out|fried|low battery|no juice|crashed"; }

cmd_safety() {
  input=""; if [ ! -t 0 ]; then while IFS= read -r -t 2 line; do input="$input$line"; done; input="$input${line:-}"; fi
  [ -n "$input" ] || input="$*"
  remember_message "$input"
  # shellcheck disable=SC1112  # the curly apostrophe is deliberate: "what’s the point" must match too
  text="$(printf '%s' "$input" | sed 's/\\u2019/'"'"'/g; s/’/'"'"'/g' | tr 'A-Z' 'a-z')"
  hit="$(printf '%s' "$text" | grep -Eo "$CRISIS_RE" | head -1 || true)"
  if [ -z "$hit" ] && [ -f .life/SETUP_NEEDED ] && [ ! -f .life/setup-progress.md ]; then
    echo "LIFE OS: not set up yet. Unless they asked for something else, reply like this: greet them, say in two lines what Life OS does (you stop being the memory; every session starts with one small step), and offer the quick start: three questions, about three minutes. On a yes, follow the life-architect skill."
  fi
  [ -n "$hit" ] || return 0
  echo "SAFETY CHECK (automatic, by keyword \"$hit\"): this message may carry crisis language. Before anything else, follow the crisis rule in AGENTS.md: stop the current task, respond with care, and if unsure ask plainly and kindly \"Are you having thoughts of ending your life?\". Include India's Tele-MANAS 14416 (free, 24/7) and 112 for immediate danger. Do not start a skill, a question menu or productivity talk first. If it is plainly not that (e.g. a button that disappears), ignore this note."
}

# ---------- ritual: which one fits now ----------
RITUALS=".claude/rituals"
ritual_file() { case "$1" in plan-day|start-day) echo "$RITUALS/start-day.md";; wrap-up|eod) echo "$RITUALS/eod.md";;
  review|weekly-review) echo "$RITUALS/weekly-review.md";; unstuck) echo "$RITUALS/unstuck.md";; steady) echo "$RITUALS/steady.md";; *) return 1;; esac; }

review_days() { # days since the last weekly review, or "none"
  if [ -f "$REVIEW_STAMP" ]; then last="$(tr -dc '0-9' < "$REVIEW_STAMP")"; [ -n "$last" ] && { echo $(( ( $(date +%s) - last ) / 86400 )); return; }; fi
  echo none
}

ritual_pick() { # prints "name<TAB>reason"
  if [ -f .life/SETUP_NEEDED ]; then printf 'setup\tnot set up yet\n'; return; fi
  mid="$(cat .life/midpoint 2>/dev/null | tr -dc '0-9:' || true)"; [ -n "$mid" ] || mid="15:00"
  nowm=$((10#$(date +%H) * 60 + 10#$(date +%M))); midm=$((10#${mid%:*} * 60 + 10#${mid#*:}))
  planned=""; [ "$(cat .life/last-plan 2>/dev/null)" = "$TODAY" ] && planned=1
  if [ "$nowm" -ge "$midm" ]; then printf 'wrap-up\tafter the midpoint (%s)\n' "$mid"
  elif [ -n "$planned" ]; then printf 'plan-day\tbefore %s; Now already planned today, so confirm the first step or ./life ritual wrap-up\n' "$mid"
  else printf 'plan-day\tbefore %s, Now not planned today\n' "$mid"; fi
}

cmd_ritual() {
  if [ -n "${1:-}" ]; then name="$1"; reason="asked for"; ritual_file "$name" >/dev/null || die "unknown ritual '$1' (plan-day, wrap-up, review, unstuck, steady)"
  else r="$(ritual_pick)"; name="$(printf '%s' "$r" | cut -f1)"; reason="$(printf '%s' "$r" | cut -f2)"; fi
  if [ "$name" = setup ]; then
    echo "ritual: setup (not set up yet)"
    echo "next: run the life-architect skill, quick start (.claude/skills/life-architect/SKILL.md)"; return
  fi
  echo "ritual: $name ($reason)"
  rd="$(review_days)"
  if [ -z "${1:-}" ] && [ "$rd" != none ] && [ "$rd" -ge 7 ]; then
    echo "review: due ($rd days). offer before starting: \"2-minute version now, the full one, or later?\" if yes: ./life ritual review"
  fi
  case "$name" in
    plan-day|start-day) [ "$(cat .life/last-plan 2>/dev/null)" = "$TODAY" ] || pending_add plan ;;
    wrap-up|eod) pending_add log ;;
    review|weekly-review) pending_add reviewed ;;
  esac
  f="$(ritual_file "$name")"; echo "file: $f"; echo "---"; cat "$f"
}

# ---------- status and start ----------
cmd_status() {
  adhd=off; [ -f .claude/.adhd-always ] && adhd=on
  echo "life: $(date '+%a %Y-%m-%d %H:%M') · adhd $adhd"
  if [ -f .life/SETUP_NEEDED ]; then
    echo "Not set up yet. Type /life (Claude Code, OpenCode) or say \"set up my life os\" (Codex). About 3 minutes."
    [ -f .life/setup-progress.md ] && echo "setup: paused; progress saved in .life/setup-progress.md (offer to resume)"
    echo "next:"
    echo "  run the life-architect skill, quick start (3 questions)"
    return 0
  fi
  T="$TODAY" awk "$DAYFN"'
    { sub(/\r$/, "") }
    /^```/ { fence = !fence; next }
    fence { next }
    /^## 20[0-9][0-9]-[01][0-9]-[0-3][0-9]/ { n++; if (n > 1) exit
      d = substr($0, 4, 10); tp = $0; sub(/^## [^ ]+ *(— *)?/, "", tp); ago = day(ENVIRON["T"]) - day(d)
      # plain if/else: macOS awk rejects chained ?: inside printf arguments
      if (ago == 0) when = "today"; else if (ago == 1) when = "yesterday"; else when = ago " days ago"
      printf "stopped: %s \"%s\" (%s)\n", d, tp, when; next }
    n == 1 && /^Stopped at:/ { f = 1; sub(/^Stopped at: */, ""); s = $0; next }
    n == 1 && /^Energy:/ { en = $0; sub(/^Energy: */, "", en); f = 0; next }
    n == 1 && /^Their words:/ { sd = $0; sub(/^Their words: */, "", sd); f = 0; next }
    n == 1 && /^[ \t]*$/ { f = 0; next }
    n == 1 && f { s = s " " $0; next }
    n == 1 && !/^(Working on|Done|Next):/ && !/^- / { other[++oc] = $0 }
    END { if (!n) { print "stopped: none yet (no dated entry in current.md)"; exit }
          if (s != "") print "  at: " s; else for (i = 1; i <= oc && i <= 3; i++) print "  " other[i]
          if (sd != "") print "  said: " sd
          if (en != "") print "  energy: " en }
  ' current.md
  if grep -q '^# Queue' queue.md 2>/dev/null; then
    q_load; q_list n
    [ "$(q_count w)" = 0 ] || q_list w
    echo "counts: next $(q_count x) · inbox $(q_count i) · someday $(q_count s) · done_this_week $(q_count d)"
  else
    echo "queue: queue.md is a pointer to another app:"; sed -n '1,5p' queue.md | sed 's/^/  /'
  fi
  rd="$(review_days)"
  if [ "$rd" = none ]; then echo "review: none yet (offer when ready)"
  elif [ "$rd" -ge 7 ]; then echo "review: due (last $rd days ago)"
  else echo "review: not due (last $rd days ago)"; fi
  pending_hint
  lr="$(learn_due)"; [ -z "$lr" ] || echo "learn: $(printf '%s' "$lr" | cut -f1) \"$(printf '%s' "$lr" | cut -f2)\" (end of session only: ./life learn)"
  rp="$(ritual_pick)"; echo "ritual: $(printf '%s' "$rp" | cut -f1) ($(printf '%s' "$rp" | cut -f2))"
  echo "next:"
  echo "  ./life ritual        steps for $(printf '%s' "$rp" | cut -f1)"
  echo "  ./life queue         every item with ids"
}

cmd_start() { # the whole session-start read, in one call, for every agent
  if [ -f .claude/.adhd-always ]; then
    echo "=== ADHD mode is on: apply these rules to every reply this session ==="
    cat .claude/skills/i-have-adhd/always-on.md
    echo
  fi
  cmd_status
  [ -f .life/SETUP_NEEDED ] && return 0
  date +%Y-%m-%d > .life/last-start # a session happened today, so no nudge
  echo "context:"
  awk '{sub(/\r$/, "")} /^## /{f=1} f' context.md | sed '/^$/d; s/^/  /'
}

NUDGE_CONF=".life/nudge"
LAUNCHD_PLIST="$HOME/Library/LaunchAgents/com.life-os.nudge.plist"
SYSTEMD_DIR="$HOME/.config/systemd/user"

nudge_text() { # one line, the first Now item if there is one; never a count or a reproach
  if grep -q private "$NUDGE_CONF" 2>/dev/null; then
    echo "Your one small step for today is ready. Open your agent and say hi."; return
  fi
  item="$(section queue.md "Now" | grep '^- ' | head -1 | sed -e 's/^- \[.\] //' -e 's/^- //' | cut -c1-90)"
  if [ -n "$item" ]; then echo "One thing today: $item. Open your agent and say hi."
  else echo "One small step is waiting whenever you're ready. Open your agent and say hi."; fi
}

nudge_show() {
  [ -f .life/SETUP_NEEDED ] && return 0
  if [ -z "${NUDGE_FORCE:-}" ] && [ "$(cat .life/last-start 2>/dev/null)" = "$(date +%Y-%m-%d)" ]; then return 0; fi
  body="$(nudge_text)"
  if [ -n "${LIFE_NUDGE_DRY:-}" ]; then echo "$body"
  elif command -v osascript >/dev/null; then
    osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "Life OS"' -e 'end run' "$body"
  elif command -v notify-send >/dev/null; then notify-send "Life OS" "$body"
  else echo "$body"; fi
}

nudge_on() {
  case "${1:-}" in [0-2][0-9]:[0-5][0-9]) ;; *) echo 'usage: ./life nudge on HH:MM [private]   e.g. ./life nudge on 09:30'; exit 1 ;; esac
  h=$((10#${1%:*})); m=$((10#${1#*:}))
  [ "$h" -lt 24 ] || { echo "Hour must be 00-23."; exit 1; }
  mkdir -p .life; echo "$*" > "$NUDGE_CONF"
  if [ "$(uname)" = Darwin ]; then
    mkdir -p "$(dirname "$LAUNCHD_PLIST")"
    cat > "$LAUNCHD_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.life-os.nudge</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$ROOT/life</string><string>nudge</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>$h</integer><key>Minute</key><integer>$m</integer></dict>
</dict></plist>
EOF
    launchctl unload "$LAUNCHD_PLIST" 2>/dev/null || true
    launchctl load "$LAUNCHD_PLIST"
  elif command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
    mkdir -p "$SYSTEMD_DIR"
    printf '[Unit]\nDescription=Life OS daily nudge\n\n[Service]\nType=oneshot\nExecStart=/bin/bash "%s/life" nudge\n' "$ROOT" > "$SYSTEMD_DIR/life-os-nudge.service"
    # Persistent: if the computer was asleep at that time, nudge at the next wake instead.
    printf '[Unit]\nDescription=Life OS daily nudge\n\n[Timer]\nOnCalendar=*-*-* %02d:%02d:00\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n' "$h" "$m" > "$SYSTEMD_DIR/life-os-nudge.timer"
    systemctl --user daemon-reload
    systemctl --user enable --now life-os-nudge.timer >/dev/null 2>&1
  else
    echo "No launchd or systemd user session here (WSL?). To schedule it yourself, run daily: bash \"$ROOT/life\" nudge"
    return 0
  fi
  echo "Nudge on: every day at $1, only on days you haven't opened Life OS yet. ./life nudge off stops it."
  command -v osascript >/dev/null || command -v notify-send >/dev/null || echo "note: no notify-send found; install libnotify so the nudge can show."
}

nudge_off() {
  if [ -f "$LAUNCHD_PLIST" ]; then launchctl unload "$LAUNCHD_PLIST" 2>/dev/null || true; rm -f "$LAUNCHD_PLIST"; fi
  if [ -f "$SYSTEMD_DIR/life-os-nudge.timer" ]; then
    systemctl --user disable --now life-os-nudge.timer >/dev/null 2>&1 || true
    rm -f "$SYSTEMD_DIR/life-os-nudge.timer" "$SYSTEMD_DIR/life-os-nudge.service"
    systemctl --user daemon-reload 2>/dev/null || true
  fi
  rm -f "$NUDGE_CONF"
  echo "Nudge off."
}

cmd_nudge() {
  case "${1:-}" in
    "") nudge_show ;;
    on) shift; nudge_on "$@" ;;
    off) nudge_off ;;
    test) NUDGE_FORCE=1 nudge_show ;;
    *) echo "usage: ./life nudge [on HH:MM [private] | off | test]"; exit 1 ;;
  esac
}

review_stamp() { mkdir -p .life; date +%s > "$REVIEW_STAMP"; }

cmd_review() { # the weekly review packet, one read
  q_load
  rd="$(review_days)"; if [ "$rd" = none ]; then rl="first review"; else rl="last $rd days ago"; fi
  echo "review: week to $TODAY ($rl)"
  q_list d
  echo "log_this_week:"
  T="$TODAY" awk "$DAYFN"'
    { sub(/\r$/, "") }
    /^```/ { fence = !fence; next }
    fence { next }
    /^## 20[0-9][0-9]-[01][0-9]-[0-3][0-9]/ { d = substr($0, 4, 10); on = (day(ENVIRON["T"]) - day(d) < 7)
      if (on) { tp = $0; sub(/^## [^ ]+ *(— *)?/, "", tp); printf "  %s %s\n", d, tp; c++ }; next }
    on && /^Stopped at:/ { sub(/^Stopped at: */, ""); print "    stopped: " $0 }
    END { if (!c) print "  none" }' current.md
  q_list i
  echo "areas:"
  found=0
  for f in areas/*/README.md; do
    [ -f "$f" ] || continue; found=1
    focus="$(awk '{sub(/\r$/, "")} /^## Current focus/{f=1; next} /^## /{f=0} f && /^- /{sub(/^- /, ""); print; exit}' "$f")"
    echo "  $(basename "$(dirname "$f")"): ${focus:-(no focus written)}"
  done
  [ "$found" = 1 ] || echo "  none yet"
  echo "therapy_notes_this_week: $(therapy_count) (say the number only, and only if others don't see their screen)"
  echo "next:"
  echo "  show wins (done + log), then sort the inbox: ./life move <ids> <section> after their yes"
  echo "  finish: ./life reviewed --focus \"a\" [--focus \"b\"] [--win \"extra win\"]..."
}

cmd_reviewed() { # no flags: stamp only. With --focus/--win: log the review, clear Done, stamp, archive.
  focus=""; wins=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --focus|--win) [ $# -ge 2 ] || die "$1 needs a value"
        v="$(printf '%s' "$2" | tr '\r\n\t' '   ')"
        if [ "$1" = --focus ]; then focus="$focus${focus:+; }$v"; else wins="$wins$v"$'\036'; fi; shift 2 ;;
      *) die "unknown flag '$1'. flags: --focus \"..\" (repeatable), --win \"..\" (repeatable)" ;;
    esac
  done
  if [ -z "$focus$wins" ]; then review_stamp; echo "ok: weekly review stamped for $TODAY"; return; fi
  q_load
  set --
  while IFS= read -r t; do [ -n "$t" ] && set -- "$@" --done "$t"; done <<EOF
$(printf '%s\n' "$QITEMS" | awk -F'\t' '$1 == "d" { print $4 }')
$(printf '%s' "$wins" | tr '\036' '\n')
EOF
  [ -n "$focus" ] && set -- "$@" --stopped "next week's focus: $focus"
  cmd_log --new --topic "Weekly review" "$@" >/dev/null
  # Done this week is now kept in that log entry, so its lines leave queue.md.
  tmp="$(mktemp)"
  awk "$QKEYFN"' { raw = $0; sub(/\r$/, "", raw) }
    /^```/ { fence = !fence }
    !fence && raw ~ /^##? / { k = key(raw) }
    k == "d" && raw ~ /^- / { next }
    { print }' queue.md | cat -s > "$tmp"
  mv "$tmp" queue.md
  review_stamp; pending_clear reviewed
  echo "ok: review logged in current.md, Done this week cleared, stamped for $TODAY"
  cmd_archive | sed 's/^/  /'
  echo "next:"
  echo "  end with ONE first action for next week, under two minutes"
}

# ---- setup: the whole quick-start build in one call ----
cmd_setup() { # setup --name X --thing "..." --adhd yes|no|trial [--step "first step"]
  name=""; thing=""; adhd=""; step=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name|--thing|--adhd|--step) [ $# -ge 2 ] || die "$1 needs a value"
        v="$(printf '%s' "$2" | tr '\r\n\t' '   ')"
        case "$1" in --name) name="$v";; --thing) thing="$v";; --adhd) adhd="$v";; --step) step="$v";; esac; shift 2 ;;
      *) die "unknown flag '$1'. usage: ./life setup --name \"..\" --thing \"..\" --adhd yes|no|trial [--step \"..\"]" ;;
    esac
  done
  [ -f .life/SETUP_NEEDED ] || die "already set up. to change things: say \"re-tune\" (life-architect skill, retune mode)"
  [ -n "$name" ] && [ -n "$thing" ] || die 'usage: ./life setup --name "Kavya" --thing "book the passport slot" --adhd yes|no|trial [--step "open the site"]'
  case "$adhd" in yes|no|trial) ;; *) die "--adhd must be yes, no or trial";; esac

  # context.md: name in, every placeholder out, empty sections marked "Not known yet."
  tmp="$(mktemp)"
  N="$name" D="$TODAY" awk '
    function flush() { if (sec != "") { printf "%s", body; if (!filled && sec != "Who this is") print "Not known yet.\n" }; body = ""; filled = 0; prev = "" }
    { sub(/\r$/, "") }
    /^Updated:/ { $0 = "Updated: " ENVIRON["D"] }
    /^## / { flush(); print; print ""; sec = substr($0, 4)
             if (sec == "Who this is") print ENVIRON["N"] ". The rest is learned a little at a time.\n"
             next }
    sec == "" { print; next }
    /\{\{/ { next }
    /^[ \t]*$/ { if (body != "" && body !~ /\n\n$/) body = body "\n"; next }
    { if ($0 ~ /^- / || ($0 ~ /^\| / && $0 !~ /^\|[- |]+\|$/ && prev ~ /^\|[- |]+\|$/) || $0 ~ /^\| This repo/) filled = 1
      body = body $0 "\n"; prev = $0 }
    END { flush() }' context.md | cat -s > "$tmp"
  mv "$tmp" context.md

  # queue.md: drop the setup item, their one thing goes in Now
  tmp="$(mktemp)"; grep -v 'to set up Life OS' queue.md > "$tmp"; mv "$tmp" queue.md
  cmd_add --now "$thing" >/dev/null

  # current.md: the install entry goes; today's entry says where to start
  tmp="$(mktemp)"
  awk '{ raw = $0; sub(/\r$/, "", raw) } raw ~ /^## \{\{DATE\}\}/ { skip = 1; next } skip && raw ~ /^## / { skip = 0 } !skip { print }' current.md > "$tmp"
  mv "$tmp" current.md
  cmd_log --topic "Life OS started" --done "Quick start: three questions" --stopped "${step:-$thing}" >/dev/null

  # AGENTS.md: the personal section, between its markers only
  mode="$adhd"; [ "$adhd" = trial ] && mode="trial for a week, ask on $(date -d '7 days' +%Y-%m-%d 2>/dev/null || date -v+7d +%Y-%m-%d) whether to keep it"
  tmp="$(mktemp)"
  P="## About the person

- **Name:** $name
- **ADHD mode:** $mode
- **Set up:** $TODAY (quick start). Setup is finished; never run it again unless they ask to re-tune.
- **Open topics:** a few questions for later, one a day at the end of a session (\`./life learn\`)." awk '
    /life-architect:personal:start/ { print; print ENVIRON["P"]; skip = 1; next }
    /life-architect:personal:end/ { skip = 0 }
    !skip { print }' AGENTS.md > "$tmp"
  grep -q 'life-architect:personal:end' "$tmp" || { rm -f "$tmp"; die "AGENTS.md lost its personal-section markers; restore them first"; }
  mv "$tmp" AGENTS.md

  if [ "$adhd" = no ]; then rm -f .claude/.adhd-always; else touch .claude/.adhd-always; fi
  mkdir -p .life
  cp .claude/skills/life-architect/to-learn.md .life/to-learn.md
  rm -f .life/SETUP_NEEDED .life/setup-progress.md
  review_stamp
  echo "ok: set up for $name (adhd: $adhd)"
  cmd_check | sed 's/^/  /'
  echo "next:"
  echo "  hand off in 3 lines: what exists now, tomorrow (\"type /life or just say hi\"), the first step: ${step:-$thing}"
}

cmd_archive() { # move current.md entries older than 4 weeks to archive/current-YYYY.md
  cutoff="$(date -d '28 days ago' +%Y-%m-%d 2>/dev/null || date -v-28d +%Y-%m-%d)"
  work="$(mktemp -d)"
  trap 'rm -rf "$work"' EXIT
  # The newest dated entry always stays, so status has something to show.
  # Undated "## " sections stay too; only dated, old entries move.
  # Headings inside ``` fences (the entry-shape example) are not entries.
  C="$cutoff" W="$work" awk '
    BEGIN { dest = "keep" }
    { sub(/\r$/, "") }
    /^```/ { fence = !fence }
    !fence && /^## / { dest = "keep"
             if (match($0, /^## 20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) && dated++) {
               d = substr($0, 4, 10)
               if (d < ENVIRON["C"]) { dest = substr(d, 1, 4); moved++ } } }
    { print > (ENVIRON["W"] "/" dest) }
    END { print moved + 0 > (ENVIRON["W"] "/count") }
  ' current.md
  moved="$(cat "$work/count")"
  if [ "$moved" = 0 ]; then
    echo "Nothing to archive: current.md has no entries older than $cutoff."; return 0
  fi
  mkdir -p archive
  for f in "$work"/[0-9][0-9][0-9][0-9]; do
    year="$(basename "$f")"; out="archive/current-$year.md"
    { printf '# current.md archive, %s\n\nEntries moved out of current.md by `./life archive`. Newest first. History, not a source of truth.\n\n' "$year"
      sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$f"; echo
      if [ -f "$out" ]; then awk '{sub(/\r$/, "")} /^## /{f=1} f' "$out"; fi
    } > "$work/out"
    mv "$work/out" "$out"
    echo "archived to $out"
  done
  sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$work/keep" > current.md # drop trailing blank lines
  echo "Moved $moved old entries (dated before $cutoff) out of current.md."
}

cmd_check() {
  ok=1
  bad() { echo "problem: $1"; echo "  fix: $2"; ok=0; }
  for f in AGENTS.md CLAUDE.md context.md current.md queue.md; do
    [ -f "$f" ] || bad "missing $f" "restore it from the template (git checkout -- $f)"
  done
  if [ -f queue.md ] && grep -q '^# Queue' queue.md; then
    for h in Now Next "Waiting on" Inbox Someday "Done this week"; do
      grep -qE "^## $h"$'\r'"?\$" queue.md || bad "queue.md has no '## $h' section" "add a line '## $h' to queue.md"
    done
    q_load; n="$(q_count n)"
    [ "$n" -le 3 ] || bad "Now has $n items (max 3)" "./life move n$n next"
    printf '%s\n' "$QITEMS" | awk -F'\t' '$1 == "w" && $4 !~ /since 20[0-9][0-9]-[01][0-9]-[0-3][0-9]/ { printf "w%d\n", $2 }' | while read -r id; do
      echo "note: $id has no 'since YYYY-MM-DD', so its wait can't be counted (./life wait adds it)"; done
  fi
  if [ ! -f .life/SETUP_NEEDED ]; then
    left="$(grep -rlF '{{' context.md current.md queue.md areas/*/README.md 2>/dev/null || true)"
    [ -z "$left" ] || bad "placeholders left in: $(echo $left)" "fill them in or delete those lines"
    awk '/personal:start/{f=1} /personal:end/{f=0} f' AGENTS.md | grep -q 'Not set up yet' && bad "AGENTS.md 'About the person' is still empty" "./life setup (quick start) or the life-architect skill"
    grep -q '^## 20[0-9][0-9]-[01][0-9]-[0-3][0-9]' current.md || bad "current.md has no dated entry" "./life log --stopped \"...\""
  fi
  if git rev-parse --git-dir >/dev/null 2>&1; then
    git check-ignore -q private/x || bad "private/ is not git-ignored" "add 'private/' to .gitignore"
    if git remote get-url origin >/dev/null 2>&1; then
      echo "reminder: this repo has a remote ($(git remote get-url origin)). Make sure it is private."
    fi
  fi
  [ "$ok" = 1 ] && echo "Life OS check: all good."
  [ "$ok" = 1 ]
}

CMD="${1:-status}"
case "$CMD" in
  status|"") cmd_status ;;
  start) cmd_start ;;
  queue|q) shift; cmd_queue "$@" ;;
  add) shift; cmd_add "$@" ;;
  move) shift; cmd_move "$@" ;;
  now|next|someday|inbox)
    k="$1"; shift
    if [ $# = 0 ]; then cmd_queue "$k"; else cmd_move "$@" "$k"; fi ;;
  done) shift; cmd_done "$@" ;;
  wait) shift; cmd_wait "$@" ;;
  plan) shift; cmd_plan "$@" ;;
  log) shift; cmd_log "$@" ;;
  therapy-note) shift; cmd_therapy_note "$@" ;;
  ritual) shift; cmd_ritual "$@" ;;
  learn) cmd_learn ;;
  learned) shift; cmd_learned "$@" ;;
  pending) shift; cmd_pending "$@" ;;
  gate) cmd_gate ;;
  safety) shift; cmd_safety "$@" ;;
  review) cmd_review ;;
  reviewed) shift; cmd_reviewed "$@" ;;
  setup) shift; cmd_setup "$@" ;;
  archive) cmd_archive ;;
  check) cmd_check ;;
  nudge) shift; cmd_nudge "$@" ;;
  help|-h|--help)
    cat <<'HELP'
life: plain-text life OS. Files are the truth; these commands read and edit them safely.
Ids: n1 = first Now item (x Next, w Waiting on, i Inbox, s Someday, d Done this week).
Any id can also be a unique quoted piece of the text: ./life done "passport".
Errors go to stderr, exit 2, and say how to fix the call.

read
  ./life                          same as status
  ./life start                    session start: ADHD rules if on, status, context.md
  ./life status                   where they stopped, Now, waiting (days), counts, what's due
  ./life queue [now|next|waiting|inbox|someday|done|all]   items with ids
  ./life ritual [name]            which ritual fits now, then its steps (plan-day, wrap-up, review, unstuck, steady)
  ./life learn                    the next getting-to-know-you question, if one is due
queue (move/done/plan only after the person says yes)
  ./life add "text" [--now|--next]    capture; default Inbox, dated
  ./life move <id...> <section>       e.g. ./life move i1 i3 next   (Now holds at most 3)
  ./life now|next|someday|inbox <id...>   shortcut for move
  ./life done <id...>                 to Done this week
  ./life wait <id> ["who"]            to Waiting on, dated "since"
  ./life plan <id...>                 Now becomes exactly these (1-3); the rest of Now goes to top of Next
log and notes
  ./life log --stopped "exact point" [--said "their exact words"] [--topic ".."] [--working ".."] [--done ".."]... [--energy ".."] [--new]
                                  write or update today's current.md entry; neutral words, no feelings
  ./life therapy-note "their words"   private, dated, never read back (only on their yes)
  ./life therapy-note --count         how many this week; the number only
  ./life learned <tN> [--skip]        after asking a learn question
setup and review
  ./life setup --name "..." --thing "..." --adhd yes|no|trial [--step "..."]   quick-start build, one call
  ./life review                   weekly review packet: done, this week's log, inbox, areas, therapy count
  ./life reviewed --focus "a" [--focus "b"] [--win ".."]   log the review, clear Done, stamp, archive
rituals and the stop gate
  ./life pending [clear [item|all]]   the write a started ritual still owes (plan, log, reviewed)
  ./life gate                     exit 2 while a write is owed; the Stop hook in Claude Code and Codex. OpenCode: run it before finishing
  ./life safety                   crisis-language net on the person's message; the UserPromptSubmit hook in Claude Code and Codex
upkeep
  ./life reviewed                 (no flags) just stamp the review done
  ./life archive                  move current.md entries older than 4 weeks to archive/
  ./life check                    structure problems, each with its fix
  ./life nudge on HH:MM [private] | off | test    daily desktop nudge, only on days Life OS wasn't opened
HELP
    ;;
  *) die "unknown command '$1'. run: ./life help" ;;
esac
case "$CMD" in queue|q|move|now|next|someday|inbox|done|wait|add|learn|learned) pending_hint ;; esac
