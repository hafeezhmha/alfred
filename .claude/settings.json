{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash ./life start 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Loading your Life OS"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash ./life gate",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
